          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 37
      },
      "id": 15,
      "targets": [
        {
          "expr": "celery_worker_tasks_active",
          "legendFormat": "{{hostname}}",
          "refId": "A"
        }
      ],
      "title": "Celery: busy task slots (stacked, capacity 14)",
      "type": "timeseries",
      "description": "Each band is one worker process (label = container id): 2 validation workers (4 slots each), scheduler (4), antivirus (2). Total height = tasks running right now; capacity is 14 slots."
    },
