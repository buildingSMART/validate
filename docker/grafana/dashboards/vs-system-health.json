      "title": "Swarm: replica deficit per service (0 = healthy)",
      "type": "timeseries",
      "description": "Flatline at 0% means every service runs its desired replica count. A line only rises when a service loses replicas — this panel is supposed to look empty.",
      "options": {
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "short",
