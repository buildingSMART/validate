      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 37
      },
      "id": 14,
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "swarm_service_replicas_desired - swarm_service_replicas_running",
          "legendFormat": "{{service}}"
        }
